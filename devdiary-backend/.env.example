NODE_ENV=development
PORT=3000
# Produção: FRONTEND_URL=https://devdiary.cloud,https://www.devdiary.cloud
FRONTEND_URL=http://localhost:3001

# Banco (docker-compose.yml na raiz do repositório)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=devdiary
DB_PASSWORD=devdiary
DB_DATABASE=devdiary

# Atrás de proxy reverso (nginx) em produção: TRUST_PROXY=1
# TRUST_PROXY=1

# Painel admin
# Segredo para assinar os tokens de login (pelo menos 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ADMIN_EMAIL=voce@exemplo.com
# Gere com: npm run hash-password  (mantenha as aspas simples)
ADMIN_PASSWORD_HASH=
